<?xml version="1.0" encoding="utf-8"?>
<Root>
  <Scene0>
	  <!--Setting up meshes and shapes-->
	  <Mesh name="MarioMesh" filename="meshes/Mario.obj">
	  </Mesh>
	  <Mesh name="MarioMimeMesh" filename="meshes/Mario.obj">
	  </Mesh>
	  <Mesh name="CubeMesh" filename="meshes/Cube.obj">
	  </Mesh>
	  <Mesh name="RookMesh" filename="meshes/Rook.obj">
	  </Mesh>
	  <!--Setting up materials-->
	  <Material name="MarioMaterial" filename="./textures/mario_fire.png"/>
	  <Material name="MarioMimeMaterial" filename="./textures/mario_mime.png"/>
	  <Material name="RookMaterial" filename="./textures/White Chess Base Colour.png"/>
	  <SkyboxMaterial name="SkyboxMaterial"
	                  posx="./textures/StarSkyboxPosx.png"
	                  negx="./textures/StarSkyboxNegx.png"
	                  posy="./textures/StarSkyboxPosy.png"
	                  negy="./textures/StarSkyboxNegY.png"
	                  posz="./textures/StarSkyboxPosz.png"
	                  negz="./textures/StarSkyboxnegz.png"/>
	  />
	  <!--Setting up shader-->
      <Shader name="Shader" vertFilename="shaders/multiPhong.vert.spv" fragFilename="shaders/multiPhong.frag.spv"/>
	  <Shader name="SkyboxShader" vertFilename="shaders/skybox.vert.spv" fragFilename="shaders/skybox.frag.spv"/>
	  
	  <!--Now that we have meshes, materials, and a shader we can set up actors-->

	  <Actor actorname="MarioFire" parent="none">
		  <Transform posx="0.0" posy="0.0" posz="0.0"
					 angleDeg="0.0" axisx="0.0" axisy="1.0" axisz="0.0"
					 scalex="1.0" scaley="1.0" scalez="1.0"/>
		  <Mesh name="MarioMesh"/>
		  <Shader name ="Shader"/>
		  <Material name ="MarioMaterial"/>
	  </Actor>

	  <Actor actorname="MarioMime" parent="none">
		  <Transform posx="2.0" posy="0.0" posz="0.0"
					 angleDeg="0.0" axisx="0.0" axisy="1.0" axisz="0.0"
					 scalex="1.0" scaley="1.0" scalez="1.0"/>
		  <Mesh name="MarioMimeMesh"/>
		  <Shader name ="Shader"/>
		  <Material name ="MarioMimeMaterial"/>
	  </Actor>

	  <Actor actorname="Rook" parent="none">
		  <Transform posx="1.0" posy="-9.0" posz="0.0"
		             angleDeg="0.0" axisx="0.0" axisy="1.0" axisz="0.0"
		             scalex="1.0" scaley="1.0" scalez="1.0"/>
		  <Mesh name="RookMesh"/>
		  <Shader name ="Shader"/>
		  <Material name ="RookMaterial"/>
	  </Actor>

	  <CameraActor actorname="Camera" parent="none">
		  <Transform posx="0.0" posy="0.0" posz="5.0"
					 angleDeg="0.0" axisx="1.0" axisy="0.0" axisz="0.0"
					 scalex="1.0" scaley="1.0" scalez="1.0"/>
		  <Mesh name ="CubeMesh"/>
		  <SkyboxMaterial name="SkyboxMaterial"/>
		  <Shader name = "SkyboxShader"/>
	  </CameraActor>
	  <!-- Set up camera and light actors-->
	  <!--
	  <Camera cameraname="Camera1" parent="none">
		  <Transform posx="0.0" posy="0.0" posz="0.0" 
					 angleDeg="0.0" axisx="1.0" axisy="0.0" axisz="0.0"
					 scalex="1.0" scaley="1.0" scalez="1.0"/>
	  </Camera>

	  <Light lightname="Light1" parent="none" lightstyle="DirectionLight"
			 posx="0.0" posy="0.0" posz="-10.0"
		     red="1.0" green="1.0" blue="1.0" alpha="0.0"
			 intensity="1.0"
			 falloffx="0.0" falloffy="0.0" falloffz="0.0"/>
			 -->
		  	  
  </Scene0>
</Root>
